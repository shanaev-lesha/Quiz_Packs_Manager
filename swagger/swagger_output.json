{
  "swagger": "2.0",
  "info": {
    "title": "Backend API",
    "description": "API проекта",
    "version": "1.0.0"
  },
  "host": "localhost:3000",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "securityDefinitions": {
    "bearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Bearer <JWT>"
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Регистрация пользователя",
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/RegisterBody"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Пользователь создан",
            "schema": {
              "$ref": "#/definitions/User"
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Авторизация",
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/LoginBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "JWT токен",
            "schema": {
              "$ref": "#/definitions/Token"
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Текущий пользователь",
        "description": "",
        "responses": {
          "200": {
            "description": "Данные пользователя",
            "schema": {
              "type": "object",
              "properties": {
                "user": {
                  "$ref": "#/definitions/User"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "401": {
            "description": "Не авторизован"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/question-packs/": {
      "post": {
        "tags": [
          "Question Packs"
        ],
        "summary": "Создать пак вопросов",
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateQuestionPackRequest"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Пак создан",
            "schema": {
              "$ref": "#/definitions/QuestionPack"
            }
          },
          "401": {
            "description": "Не авторизован"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "get": {
        "tags": [
          "Question Packs"
        ],
        "summary": "Получить все паки пользователя",
        "description": "",
        "responses": {
          "200": {
            "description": "Список паков",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/QuestionPack"
              },
              "xml": {
                "name": "main"
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/question-packs/{id}": {
      "get": {
        "tags": [
          "Question Packs"
        ],
        "summary": "Получить пак по ID",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Пак",
            "schema": {
              "$ref": "#/definitions/QuestionPack"
            }
          },
          "404": {
            "description": "Не найден"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "put": {
        "tags": [
          "Question Packs"
        ],
        "summary": "Обновить пак",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "schema": {
              "$ref": "#/definitions/UpdateQuestionPackRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Обновлённый пак",
            "schema": {
              "$ref": "#/definitions/QuestionPack"
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Question Packs"
        ],
        "summary": "Удалить пак",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "204": {
            "description": "Удалено"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Проверка состояния сервера",
        "description": "",
        "responses": {
          "200": {
            "description": "Endpoint проверяет работает ли сервер"
          }
        }
      }
    }
  },
  "definitions": {
    "RegisterBody": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "example": "test@test.com"
        },
        "password": {
          "type": "string",
          "example": "Password1"
        }
      },
      "required": [
        "email",
        "password"
      ]
    },
    "LoginBody": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "example": "test@test.com"
        },
        "password": {
          "type": "string",
          "example": "Password1"
        }
      },
      "required": [
        "email",
        "password"
      ]
    },
    "User": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "uuid"
        },
        "email": {
          "type": "string",
          "example": "user@mail.com"
        },
        "created_at": {
          "type": "string",
          "example": "2026-01-01T10:00:00Z"
        }
      }
    },
    "Token": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "example": "jwt.token.here"
        }
      }
    },
    "QuestionPack": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "uuid"
        },
        "user_id": {
          "type": "string",
          "example": "uuid"
        },
        "title": {
          "type": "string",
          "example": "Название пака"
        },
        "description": {
          "type": "string",
          "example": "Описание"
        },
        "status": {
          "type": "string",
          "example": "draft"
        },
        "created_at": {
          "type": "string",
          "example": "2026-01-01T10:00:00Z"
        },
        "updated_at": {
          "type": "string",
          "example": "2026-01-01T10:00:00Z"
        }
      }
    },
    "CreateQuestionPackRequest": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "example": "My pack"
        },
        "description": {
          "type": "string",
          "example": "Описание"
        },
        "status": {
          "type": "string",
          "example": "draft"
        }
      },
      "required": [
        "title"
      ]
    },
    "UpdateQuestionPackRequest": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "example": "Updated title"
        },
        "description": {
          "type": "string",
          "example": "Новое описание"
        },
        "status": {
          "type": "string",
          "example": "published"
        }
      }
    }
  },
  "responses": {
    "Unauthorized": {
      "description": "Не авторизован"
    },
    "Created": {
      "description": "Пользователь создан"
    },
    "ValidationError": {
      "description": "Ошибка валидации"
    }
  }
}