{
  "swagger": "2.0",
  "info": {
    "title": "Backend API",
    "description": "API проекта",
    "version": "1.0.0"
  },
  "host": "localhost:3000",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "securityDefinitions": {
    "bearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Bearer <JWT>"
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Регистрация пользователя",
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/RegisterBody"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Пользователь создан",
            "schema": {
              "$ref": "#/definitions/User"
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Авторизация",
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/LoginBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "JWT токен",
            "schema": {
              "$ref": "#/definitions/Token"
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Текущий пользователь",
        "description": "",
        "responses": {
          "200": {
            "description": "Данные пользователя",
            "schema": {
              "type": "object",
              "properties": {
                "user": {
                  "$ref": "#/definitions/User"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "401": {
            "description": "Не авторизован"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Проверка состояния сервера",
        "description": "",
        "responses": {
          "200": {
            "description": "Endpoint проверяет работает ли сервер"
          }
        }
      }
    }
  },
  "definitions": {
    "RegisterBody": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "example": "test@test.com"
        },
        "password": {
          "type": "string",
          "example": "Password1"
        }
      },
      "required": [
        "email",
        "password"
      ]
    },
    "LoginBody": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "example": "test@test.com"
        },
        "password": {
          "type": "string",
          "example": "Password1"
        }
      },
      "required": [
        "email",
        "password"
      ]
    },
    "User": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "uuid"
        },
        "email": {
          "type": "string",
          "example": "user@mail.com"
        },
        "created_at": {
          "type": "string",
          "example": "2026-01-01T10:00:00Z"
        }
      }
    },
    "Token": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "example": "jwt.token.here"
        }
      }
    }
  },
  "responses": {
    "Unauthorized": {
      "description": "Не авторизован"
    },
    "Created": {
      "description": "Пользователь создан"
    },
    "ValidationError": {
      "description": "Ошибка валидации"
    }
  }
}